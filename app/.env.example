# CatalogHQ frontend (Vite). Copy to .env.local for local development.
# Never commit secrets here. All VITE_* values are bundled into the client.

# Required in production builds
VITE_USE_API=true

# API origin (no trailing slash). Used for fetch() and CSP connect-src at build time.
VITE_API_URL=http://localhost:3001

# Production example:
# VITE_API_URL=https://api.cataloghq.store

# Public site origin (no trailing slash). Used for Open Graph / X link preview image URLs.
# VITE_SITE_URL=https://cataloghq.store
