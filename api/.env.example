# Windows PG often uses port 5433 if 5432 is taken (e.g. by WSL/Docker)
# URL-encode special chars in password (@ → %40)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/postgres?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
JWT_ADMIN_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_DAYS="7"
PORT=3001
# Shared rate-limit store (required when NODE_ENV=production)
# Local: redis://localhost:6379
# Railway (same project): use the Redis service variable, usually redis://default:PASSWORD@redis.railway.internal:6379
# Prefer "Add variable reference" from the Redis service in Railway instead of pasting secrets into git.
# REDIS_URL=
# Comma-separated frontend origins (no quotes in Railway dashboard)
CORS_ORIGIN=http://localhost:3000,https://cataloghq.store,https://www.cataloghq.store

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cataloghq/products

# Pingram (email: OTP, password reset, verification notices)
# Add cataloghq.store DNS records in Pingram dashboard, then set PINGRAM_API_KEY from Environments.
PINGRAM_API_KEY=
PINGRAM_BASE_URL=https://api.pingram.io
PINGRAM_FROM_EMAIL=noreply@cataloghq.store
PINGRAM_FROM_NAME=CatalogHQ

# Flutterwave (order checkout v3 bank transfer, vendor payouts v4 transfer)
# Production dashboard: https://app.flutterwave.com
# Sandbox dashboard (local dev only): https://developersandbox.flutterwave.com
# Webhook URL (live): https://api.cataloghq.store/payments/flutterwave/webhook
# In Flutterwave dashboard (Settings > Webhooks):
# - URL must match exactly (HTTPS, no trailing slash)
# - Secret hash must match FLUTTERWAVE_WEBHOOK_SECRET below
# - Enable webhook retries (3 retries, 30 min apart)
# Flutterwave signs the raw POST body with HMAC-SHA256 and sends flutterwave-signature.
# The API verifies that header against FLUTTERWAVE_WEBHOOK_SECRET, then processes the event
# synchronously before returning HTTP 200 (Flutterwave retries on failure).
# Vendor payouts (default: instant — full customer payment to you, then transfer vendor share from your balance):
# - Customer pays full order amount into your Flutterwave collection (no checkout split).
# - On payment confirm, API sends vendorNet to vendor bank via v4 instant transfer from payout balance.
# - Customer funds settle to your bank on Flutterwave schedule (usually T+1); that refills your float.
# - Top up Flutterwave payout balance before launch; keep enough for peak daily vendorNet + transfer fees.
# - Flutterwave: Settings > Business preferences > Security > transfer source = API or Both.
# - Settlement destination: your bank account (automatic).
# FLUTTERWAVE_VENDOR_PAYOUT_MODE=instant
#
# Optional split mode (set FLUTTERWAVE_VENDOR_PAYOUT_MODE=split only if you prefer subaccount settlement):
# - Customer payment split at charge: platform fee to you, vendor share to subaccount. No instant transfer.
#
# Vendors link payout bank in dashboard (transfer recipient; subaccount only in split mode).
# Minimum automatic instant transfer payout per order: 300 NGN.
# Whitelist your server IP for Flutterwave API calls (or 0.0.0.0 on Hobby).
FLUTTERWAVE_VENDOR_PAYOUT_MODE=instant
FLUTTERWAVE_ENV=production
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_WEBHOOK_SECRET=
# Production rejects order payment confirm when Flutterwave API verify fails (webhook-only).
# Must stay false in production (API boot fails if true when NODE_ENV=production).
# Set true only for explicit local sandbox debugging.
# PAYMENT_ALLOW_WEBHOOK_ONLY_CONFIRM=false
FLUTTERWAVE_CALLBACK_BASE_URL=https://cataloghq.store
# v3 secret key: Settings > API Keys (Secret key). Used for order bank transfer checkout.
FLUTTERWAVE_SECRET_KEY=
# Sandbox only (leave unset in production):
# FLUTTERWAVE_ENV=sandbox
# FLUTTERWAVE_CALLBACK_BASE_URL=http://localhost:3000
# FLUTTERWAVE_SCENARIO_KEY=scenario:auth_redirect&issuer:approved

# Vendor subscriptions (Paystack Direct Debit + monthly plans)
# Webhook URL (live): https://api.cataloghq.store/subscriptions/paystack/webhook
# Paystack dashboard: Settings > API Keys & Webhooks. Add the webhook URL there.
# Webhook signatures use the same PAYSTACK_SECRET_KEY (no separate webhook secret).
# Checkout uses bank (Direct Debit) channel with a Paystack plan for recurring billing.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_BASE_URL=https://cataloghq.store
# Grace period after failed renewal before hard-block (days)
SUBSCRIPTION_GRACE_DAYS=2
# Comp period for existing vendors on first migration (days, set via SQL backfill)
SUBSCRIPTION_COMP_DAYS=30

# 64-character hex string. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NIN_ENCRYPTION_KEY=
# Optional separate key for admin TOTP secrets (falls back to NIN_ENCRYPTION_KEY)
TOTP_ENCRYPTION_KEY=

# Local dev only: allow mock order/subscription flows when payment providers are unset
# ALLOW_DEV_PAYMENT_MOCKS=true (blocked when NODE_ENV=production)

# Ashlab NIN verification (vendor identity)
# Copy API_KEY, API_SECRET, and BEARER_TOKEN from the Ashlab verify dashboard.
# Test NIN: 11111111111 (only works with test keys)
#
# Auth priority for POST /verify/nin:
# 1) ASHLAB_VERIFY_BEARER_TOKEN if set (sent as Authorization: Bearer <token>)
# 2) else API_KEY + API_SECRET (sent as Authorization: Bearer <key>:<secret>)
# 3) else API_KEY only (sent as Authorization: Bearer <key>)
ASHLAB_VERIFY_API_KEY=
ASHLAB_VERIFY_API_SECRET=
ASHLAB_VERIFY_BEARER_TOKEN=
ASHLAB_VERIFY_BASE_URL=https://verify.ashlabtech.ng/api/v1
ASHLAB_VERIFY_PATH=/verify/nin
# Wrong hosts/paths (do not use):
# ASHLAB_VERIFY_BASE_URL=https://verify.ashlabtech.ng/v1
# ASHLAB_VERIFY_PATH=/nin/verify
# ASHLAB_VERIFY_BASE_URL=https://api.verify.ashlabtech.ng/api/v1
#
# Log Ashlab request/response and name matching (local/staging only; blocked when NODE_ENV=production)
# ASHLAB_VERIFY_DEBUG=true