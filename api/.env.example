# Windows PG often uses port 5433 if 5432 is taken (e.g. by WSL/Docker)
# URL-encode special chars in password (@ → %40)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/postgres?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=dowdexrxc
CLOUDINARY_API_KEY=552384874249524
CLOUDINARY_API_SECRET=8BuPPlY_pxfQbr8DnpFUGIhkgbI
CLOUDINARY_FOLDER=cataloghq/products

# SendChamp (SMS + email notifications)
# Verify cataloghq.store in SendChamp dashboard before live OTP email delivery.
# In SendChamp → Account settings → APIs and Webhooks, set Live webhook URL to:
# https://api.cataloghq.store/webhooks/sendchamp
# (Use your deployed API host if different from api.cataloghq.store.)
SENDCHAMP_API_KEY=
SENDCHAMP_MODE=test
SENDCHAMP_SMS_SENDER=CatalogHQ
SENDCHAMP_FROM_EMAIL=support@cataloghq.store
SENDCHAMP_FROM_NAME=CatalogHQ

# Paystack (payments)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_BASE_URL=http://localhost:3000
