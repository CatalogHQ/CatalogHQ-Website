# Windows PG often uses port 5433 if 5432 is taken (e.g. by WSL/Docker)
# URL-encode special chars in password (@ → %40)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/postgres?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=shopoint/products

# SendChamp (SMS + email notifications)
SENDCHAMP_API_KEY=
SENDCHAMP_MODE=test
SENDCHAMP_SMS_SENDER=ShopEase
SENDCHAMP_FROM_EMAIL=support@shopease.ng
SENDCHAMP_FROM_NAME=ShopEase

# Paystack (payments)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_BASE_URL=http://localhost:3000
