# Windows PG often uses port 5433 if 5432 is taken (e.g. by WSL/Docker)
# URL-encode special chars in password (@ → %40)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/postgres?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
# Comma-separated frontend origins (no quotes in Railway dashboard)
CORS_ORIGIN=http://localhost:3000,https://cataloghq.store,https://www.cataloghq.store

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cataloghq/products

# Pingram (email: OTP, password reset, verification notices)
# Add cataloghq.store DNS records in Pingram dashboard, then set PINGRAM_API_KEY from Environments.
PINGRAM_API_KEY=
PINGRAM_BASE_URL=https://api.pingram.io
PINGRAM_FROM_EMAIL=noreply@cataloghq.store
PINGRAM_FROM_NAME=CatalogHQ

# Flutterwave (order checkout v4, subscriptions v3, split payouts v3)
# Production dashboard: https://app.flutterwave.com
# Sandbox dashboard (local dev only): https://developersandbox.flutterwave.com
# Webhook URL (live): https://api.cataloghq.store/payments/flutterwave/webhook
# Enable Split payments + Automatic settlement on the live dashboard.
FLUTTERWAVE_ENV=production
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_CALLBACK_BASE_URL=https://cataloghq.store
# v3 secret key: Settings > API Keys (Secret key). Same live account as above.
FLUTTERWAVE_SECRET_KEY=
# Sandbox only (leave unset in production):
# FLUTTERWAVE_ENV=sandbox
# FLUTTERWAVE_CALLBACK_BASE_URL=http://localhost:3000
# FLUTTERWAVE_SCENARIO_KEY=scenario:auth_redirect&issuer:approved

# Vendor subscriptions (Flutterwave v3 payment plans)
# Grace period after failed renewal before hard-block (days)
SUBSCRIPTION_GRACE_DAYS=2
# Comp period for existing vendors on first migration (days, set via SQL backfill)
SUBSCRIPTION_COMP_DAYS=30

# 64-character hex string. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NIN_ENCRYPTION_KEY=

# Ashlab NIN verification (vendor identity)
# Copy API_KEY, API_SECRET, and BEARER_TOKEN from the Ashlab verify dashboard.
# Test NIN: 11111111111 (only works with test keys)
#
# Auth priority for POST /verify/nin:
# 1) ASHLAB_VERIFY_BEARER_TOKEN if set (sent as Authorization: Bearer <token>)
# 2) else API_KEY + API_SECRET (sent as Authorization: Bearer <key>:<secret>)
# 3) else API_KEY only (sent as Authorization: Bearer <key>)
ASHLAB_VERIFY_API_KEY=
ASHLAB_VERIFY_API_SECRET=
ASHLAB_VERIFY_BEARER_TOKEN=
ASHLAB_VERIFY_BASE_URL=https://verify.ashlabtech.ng/api/v1
ASHLAB_VERIFY_PATH=/verify/nin
# Wrong hosts/paths (do not use):
# ASHLAB_VERIFY_BASE_URL=https://verify.ashlabtech.ng/v1
# ASHLAB_VERIFY_PATH=/nin/verify
# ASHLAB_VERIFY_BASE_URL=https://api.verify.ashlabtech.ng/api/v1
#
# Log Ashlab request/response and name matching (auto-on when NODE_ENV is not production)
# ASHLAB_VERIFY_DEBUG=true