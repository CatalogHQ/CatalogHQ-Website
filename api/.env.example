# Windows PG often uses port 5433 if 5432 is taken (e.g. by WSL/Docker)
# URL-encode special chars in password (@ → %40)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/postgres?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
# Comma-separated frontend origins (no quotes in Railway dashboard)
CORS_ORIGIN=http://localhost:3000,https://cataloghq.store,https://www.cataloghq.store

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=dowdexrxc
CLOUDINARY_API_KEY=552384874249524
CLOUDINARY_API_SECRET=8BuPPlY_pxfQbr8DnpFUGIhkgbI
CLOUDINARY_FOLDER=cataloghq/products

# Pingram (email: OTP, password reset, verification notices)
# Add cataloghq.store DNS records in Pingram dashboard, then set PINGRAM_API_KEY from Environments.
PINGRAM_API_KEY=
PINGRAM_BASE_URL=https://api.pingram.io
PINGRAM_FROM_EMAIL=noreply@cataloghq.store
PINGRAM_FROM_NAME=CatalogHQ

# Paystack (payments)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_BASE_URL=http://localhost:3000
