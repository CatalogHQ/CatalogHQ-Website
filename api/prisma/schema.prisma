generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  starter
  pro
  growth
  business
}

enum UserRole {
  vendor
  admin
}

enum VendorVerificationStatus {
  unsubmitted
  pending
  verified
  rejected
}

enum EmailOtpPurpose {
  signup
  password_reset
}

enum SubscriptionStatus {
  pending
  active
  past_due
  grace
  expired
  canceled
}

enum SubscriptionPaymentStatus {
  pending
  paid
  failed
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  phone              String?
  passwordHash       String
  emailVerifiedAt    DateTime?
  planTier           PlanTier            @default(starter)
  subscriptionExempt Boolean             @default(false)
  role               UserRole            @default(vendor)
  totpSecret         String?
  totpEnabled        Boolean             @default(false)
  totpVerifiedAt     DateTime?
  createdAt          DateTime            @default(now())
  store              Store?
  subscription       VendorSubscription?
  subscriptionPayments SubscriptionPayment[]
}

model SignupPending {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model EmailOtp {
  id        String          @id @default(uuid())
  email     String
  purpose   EmailOtpPurpose
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())

  @@index([email, purpose])
  @@index([email, createdAt])
}

model OtpSendLog {
  id        String   @id @default(uuid())
  email     String
  ipAddress String
  createdAt DateTime @default(now())

  @@index([email, ipAddress, createdAt])
  @@index([ipAddress, createdAt])
}

model OtpSendLock {
  email       String
  ipAddress   String
  lockedUntil DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([email, ipAddress])
}

model OtpIpSendLock {
  ipAddress   String   @id
  lockedUntil DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OtpVerifyAttempt {
  email       String   @id
  attempts    Int      @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime @updatedAt
}

model ProcessedWebhook {
  id          String   @id @default(cuid())
  txRef       String   @unique
  processedAt DateTime @default(now())

  @@index([processedAt])
}

enum OrderStatus {
  reserved
  paid
  confirmed
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum PayoutStatus {
  pending
  processing
  split
  settled
  failed
}

model Store {
  vendorId                String                   @id
  vendor                  User                     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  slug                    String                   @unique
  businessName            String
  legalFirstName          String?
  legalLastName           String?
  bio                     String
  whatsapp                String
  instagramHandle         String?
  tiktokHandle            String?
  facebookHandle          String?
  xHandle                 String?
  nin                     String
  ninHash                 String?                  @unique
  category                String?
  address                 String?
  city                    String?
  state                   String?
  setupComplete           Boolean                  @default(false)
  verificationStatus      VendorVerificationStatus @default(unsubmitted)
  verificationSubmittedAt DateTime?
  verifiedAt              DateTime?
  rejectionReason         String?
  payoutBankCode          String?
  payoutBankName          String?
  payoutAccountNumber     String?
  payoutAccountName       String?
  flutterwaveSubaccountId         String?
  flutterwaveTransferRecipientId  String?
  payoutSetupComplete             Boolean                  @default(false)
  payoutSetupAt           DateTime?
  quickReplyTemplates     Json                     @default("[]")
  deliveryZones           Json                     @default("[]")
  products                Product[]
  orders                  Order[]
  reviews                 Review[]
  discountCodes           DiscountCode[]
  storeMembers            StoreMember[]
  activityLogs            ActivityLog[]
}

enum TicketStatus {
  open
  in_progress
  resolved
}

enum TicketType {
  vendor
  customer
}

enum TicketPriority {
  low
  medium
  high
}

model Review {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [vendorId], onDelete: Cascade)
  buyerName   String
  rating      Int
  comment     String
  productName String?
  verified    Boolean  @default(false)
  orderId     String?  @unique
  createdAt   DateTime @default(now())

  @@index([storeId])
}

model SupportTicket {
  id           String         @id @default(uuid())
  subject      String
  description  String
  type         TicketType
  status       TicketStatus   @default(open)
  priority     TicketPriority @default(medium)
  contactName  String
  contactPhone String
  contactEmail String?
  storeName    String?
  orderRef     String?
  vendorId     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Product {
  id                String                 @id @default(uuid())
  storeId           String
  store             Store                  @relation(fields: [storeId], references: [vendorId], onDelete: Cascade)
  name              String
  description       String                 @default("")
  price             Int
  imageUrl          String?
  images            Json                   @default("[]")
  colors            Json                   @default("[]")
  productCategory   String
  sizingType        String                 @default("none")
  sizes             Json                   @default("[]")
  deliveryOptions   Json                   @default("[]")
  stock             Int                    @default(0)
  lowStockThreshold Int                    @default(5)
  published         Boolean                @default(false)
  createdAt         DateTime               @default(now())
  stockLocations    ProductStockLocation[]

  @@index([storeId])
}

model ProductStockLocation {
  id           String  @id @default(uuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationName String
  stock        Int     @default(0)

  @@unique([productId, locationName])
}

model DiscountCode {
  id          String    @id @default(uuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [vendorId], onDelete: Cascade)
  code        String
  type        String
  value       Int
  expiresAt   DateTime?
  maxUses     Int?
  useCount    Int       @default(0)
  active      Boolean   @default(true)
  flashEndsAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([storeId, code])
  @@index([storeId])
}

model AbandonedCart {
  id            String    @id @default(uuid())
  storeId       String
  productId     String
  customerPhone String?
  customerName  String?
  cartData      Json
  recoveredAt   DateTime?
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([storeId])
}

model StoreMember {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [vendorId], onDelete: Cascade)
  userId    String
  role      String
  createdAt DateTime @default(now())

  @@unique([storeId, userId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [vendorId], onDelete: Cascade)
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([storeId])
}

model PlanCatalogEntry {
  tier                     PlanTier @id
  name                     String
  monthlyPriceKobo         Int
  priceSubtext             String
  tagline                  String
  cta                      String
  popular                  Boolean  @default(false)
  productLimit             Int
  active                   Boolean  @default(true)
  featureBullets           Json     @default("[]")
  sortOrder                Int      @default(0)
  flutterwavePaymentPlanId Int?
  updatedAt                DateTime @updatedAt
}

model VendorSubscription {
  vendorId                 String             @id
  vendor                   User               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status                   SubscriptionStatus @default(pending)
  planTier                 PlanTier           @default(starter)
  flutterwaveSubscriptionId String?
  flutterwaveCustomerId    String?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  graceEndsAt              DateTime?
  canceledAt               DateTime?
  cancelAtPeriodEnd        Boolean            @default(false)
  lastPaymentAt            DateTime?
  lastPaymentReference     String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
}

model SubscriptionPayment {
  id                  String                    @id @default(uuid())
  vendorId            String
  vendor              User                      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  planTier            PlanTier
  amountKobo          Int
  currency            String                    @default("NGN")
  flutterwaveReference String                   @unique
  status              SubscriptionPaymentStatus @default(pending)
  paidAt              DateTime?
  createdAt           DateTime                  @default(now())

  @@index([vendorId])
}

model Order {
  id                  String        @id @default(uuid())
  paymentRef          String        @unique
  storeId             String
  store               Store         @relation(fields: [storeId], references: [vendorId], onDelete: Cascade)
  productId           String
  productName         String
  color               String?
  size                String?
  quantity            Int
  deliveryType        String
  unitPrice           Int
  deliveryFee         Int           @default(0)
  discountAmount      Int           @default(0)
  discountCode        String?
  totalPaid           Int
  vendorNet           Int           @default(0)
  platformFee         Int           @default(0)
  payoutStatus        PayoutStatus  @default(pending)
  customerName        String
  customerPhone       String
  deliveryAddress     String?
  status              OrderStatus   @default(reserved)
  paymentStatus       PaymentStatus @default(pending)
  gatewayReference            String?       @unique @map("paystackReference")
  flutterwaveTransferId       String?
  flutterwavePayoutReference  String?       @unique
  transferReference           String?
  reservedUntil       DateTime?
  internalNotes       String?
  estimatedDeliveryAt DateTime?
  riderName           String?
  riderPhone          String?
  vendorSeenAt        DateTime?
  createdAt           DateTime      @default(now())

  @@index([storeId])
  @@index([paymentRef])
  @@index([customerPhone])
}
